{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uvx -p 3.13 --from git+https://github.com/Areo-RGB/serena-main serena-hooks remind --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uvx -p 3.13 --from git+https://github.com/Areo-RGB/serena-main serena-hooks activate --client=claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uvx -p 3.13 --from git+https://github.com/Areo-RGB/serena-main serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ]
  }
}
